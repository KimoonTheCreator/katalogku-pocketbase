# Ganti sesuai server: localhost / IP server / URL Cloudflare
@baseUrl = http://localhost:8080/api

# Nilai di bawah diambil otomatis oleh REST Client dari hasil request sebelumnya
@productId = {{list.response.body.$.items[0].id}}
@token = {{login.response.body.$.token}}
@userId = {{login.response.body.$.record.id}}

### 1. Cek gateway
GET {{baseUrl}}/health

### 2. Daftar produk (5 terbaru)
# @name list
GET {{baseUrl}}/products?perPage=5&sort=-created

### 3. Cari produk dengan filter PocketBase
GET {{baseUrl}}/products?filter=title~'kopi'

### 4. Detail produk
GET {{baseUrl}}/products/{{productId}}

### 5. Registrasi akun user baru
POST {{baseUrl}}/auth/records
Content-Type: application/json

{
  "name": "Budi",
  "email": "budi@itb.ac.id",
  "password": "rahasia123",
  "passwordConfirm": "rahasia123"
}

### 6. Login
# @name login
POST {{baseUrl}}/auth/auth-with-password
Content-Type: application/json

{
  "identity": "budi@itb.ac.id",
  "password": "rahasia123"  
}

### 7. Tambah favorit
POST {{baseUrl}}/favorites
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user": "{{userId}}",
  "product_id": "{{productId}}"
}

### 8. Lihat daftar favorit milik sendiri
GET {{baseUrl}}/favorites
Authorization: Bearer {{token}}

### 9. Hapus favorit (ganti ID_FAVORIT sesuai data)
DELETE {{baseUrl}}/favorites/ID_FAVORIT
Authorization: Bearer {{token}}